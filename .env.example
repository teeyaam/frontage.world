# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real secrets. Locally, `node server.js` loads .env automatically
# (via the dotenv package). In production (Render, etc.), set these as real
# environment variables in your host's dashboard instead of a file.

# ---------------- Database (required) ----------------
# Postgres connection string. Render's free-tier Postgres gives you this
# directly from its dashboard — use the "External Database URL" so it also
# works from your local machine during development.
DATABASE_URL=postgres://user:password@host:5432/dbname

# ---------------- File storage (required for uploads) ----------------
# Cloudflare R2 (or any S3-compatible provider). Without these set, listing
# photo and contractor document uploads fall back to local disk — fine for
# a quick local test, not durable once actually hosted.
S3_BUCKET=frontage-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
# Public base URL your bucket serves files from — either R2's own public
# bucket URL, or a custom domain you've mapped to it. Only needed for the
# public listing-photos prefix; contractor docs never use this (private,
# always served via a signed URL).
S3_PUBLIC_BASE_URL=https://uploads.yourdomain.com

# ---------------- Stripe (optional until you're ready) ----------------
# Leave these unset and the app runs in "stub" payment mode — bookings still
# work end-to-end, just without a real charge. Use test-mode keys
# (sk_test_.../pk_test_...) while developing; switch to live keys only once
# you're ready to take real payments.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From the Stripe CLI (`stripe listen --forward-to localhost:3000/api/stripe/webhook`)
# for local testing, or from the webhook's settings page once deployed.
STRIPE_WEBHOOK_SECRET=

# ---------------- Email (Resend — resend.com, optional until configured) ----------------
# Without these, all email features (signup verification, booking/job
# notifications, contact-form forwarding, lease reminders) are logged no-ops
# and email verification is skipped at signup.
RESEND_API_KEY=
# Must use a domain verified in Resend, e.g. "Frontage <hello@frontage.world>"
EMAIL_FROM=
# Where contact-form submissions are forwarded
CONTACT_EMAIL=
# Absolute origin used inside email links
APP_BASE_URL=https://frontage.world

# ---------------- Private preview mode (optional) ----------------
# Set to any secret code to lock the whole site behind a shared passcode
# while you refine it. Remove the variable to go public.
SITE_PASSCODE=

# ---------------- Misc ----------------
# Used to sign session tokens so a leaked database dump alone can't forge a
# login. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

PORT=3000
