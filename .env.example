# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real secrets. Locally, the app loads .env automatically (dotenv).
# In production (Render), set these as environment variables in the
# service's dashboard instead.

# ---------------- Database (required) ----------------
# Local development: a Neon *dev branch* (never the production database).
# Production: the Render Postgres "Internal Database URL".
DATABASE_URL=postgres://user:password@host:5432/dbname

# ---------------- Site ----------------
# Absolute origin used in emails, social preview tags, the sitemap and to
# decide whether cookies are marked Secure (https → Secure).
APP_BASE_URL=https://frontage.world
PORT=3000
# Staging only: tells search engines not to index this copy of the site.
NOINDEX=
# Optional shared passcode that locks the whole site (staging / pre-launch).
# Remove it to go public — it also blocks Facebook's link-preview crawler.
SITE_PASSCODE=
# Shown in the Terms and Privacy Policy, e.g. "Jane Citizen" / "12 345 678 901".
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_ABN=

# ---------------- Photo storage (Cloudflare R2 / S3) ----------------
# Without these, uploads go to local disk (fine for local dev only).
S3_BUCKET=frontage-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
# Public URL the bucket is served from, e.g. https://media.frontage.world
S3_PUBLIC_BASE_URL=

# ---------------- Email (Resend) ----------------
# Without these, emails are logged no-ops and new accounts are
# auto-verified (there'd be no way to deliver the link).
RESEND_API_KEY=
# Must use a domain verified in Resend, e.g. "Frontage <hello@frontage.world>"
EMAIL_FROM=
# Where contact-form messages and new reports are sent.
CONTACT_EMAIL=

# ---------------- Google Maps ----------------
# BROWSER key: visible to visitors. In Google Cloud restrict it by HTTP
# referrer (https://frontage.world/*, https://www.frontage.world/*, and
# http://localhost:3000/* for dev) and to: Maps JavaScript API, Places API
# (New), Maps Embed API. Without it: Leaflet/OpenStreetMap maps and a plain
# address box.
GOOGLE_MAPS_API_KEY=
# SERVER key: never sent to browsers. Restrict it to the Geocoding API
# (and, if you like, Render's outbound IPs). Without it the server
# geocodes with OpenStreetMap instead.
GOOGLE_MAPS_SERVER_KEY=
# Address search is limited to these countries (ISO codes, comma-separated).
PLACES_COUNTRIES=au

# ---------------- Analytics (optional) ----------------
# Nothing loads until a visitor accepts the cookie notice.
GA4_MEASUREMENT_ID=
META_PIXEL_ID=
